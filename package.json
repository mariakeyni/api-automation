{
    "name": "reqresin-project",
    "version": "1.0.0",
    "description": "API Testing GET and POST",
    "type": "module",
    "scripts": {
        "tesjalanin": "mocha test/api/coba.test.js",
        "tes-semua": "mocha test --recursive --timeout 20000 --reporter spec",
        "tes-reqres": "mocha test --recursive --timeout 10000 --reporter spec",
        "tes-report-html": "npx mocha test --recursive --reporter mocha-simple-html-reporter --reporter-options output=test-report.html",
        "tes-report-json": "mocha test --recursive --reporter json > test-result.json"
    },
    "dependencies": {
        "ajv": "^8.17.1",
        "mocha": "^11.1.0",
        "node-fetch": "^3.3.2"
    },
    "devDependencies": {
        "chai": "^4.5.0",
        "mocha-simple-html-reporter": "^2.0.0"
    }
}
